# ============================================================
#  화이트리스트 방식입니다.
#
#  이 폴더에는 data.go.kr 인증키(config.yaml), 사내 수신자 주소,
#  실제 공고문 PDF, 수집 결과가 함께 들어 있습니다.
#  그래서 "전부 제외" 를 기본으로 두고, 올릴 파일만 아래에서 되살립니다.
#  git add . 을 실수로 해도 사내 자료가 딸려 올라가지 않습니다.
#
#  ※ 새 파일을 레포에 올리려면 아래에 ! 로 한 줄 추가해야 합니다.
#    안 하면 git status 에 아예 안 보입니다. 헷갈리면 이렇게 확인하세요.
#        git status --ignored
# ============================================================

# 먼저 전부 제외
*

# --- 올릴 것 ---
!.gitignore
!.gitattributes
!README.md
!개발.md
!config.example.yaml

!수집기.py
!점수.py
!점수표.yaml
!점수표_검증.py
!실행.bat

!편집기.py
!편집기.bat

# 기관 자체 홈페이지 게시판 (크롤링 1단계)
# 게시판.yaml 은 담당자가 고치는 파일이라 config 처럼 예제만 올릴까 했지만,
# 인증키도 수신자도 안 들어가고 주소뿐이라 그대로 올린다. 예제를 따로 두면
# 게시판이 늘 때마다 두 파일을 같이 고쳐야 해서 어긋난다.
!게시판.py
!게시판.yaml

# 기관별 입찰공고 게시판 주소 정리 (수집 대상 참고자료)
# 요구사항/ 는 사내 문서라 통째로 빠져 있다. 이 파일 하나만 되살린다.
# 요구사항/* 로 다시 막아 두었으니 그 폴더에 새로 넣는 파일은 그대로 제외된다.
!요구사항/
요구사항/*
!요구사항/기관_입찰공고_페이지.md

# exe 배포 (빌드.bat → dist\나라장터 수집기\)
# build/ 와 dist/ 는 위의 * 로 이미 빠진다. 만들어 낸 것이라 올리지 않는다.
!앱경로.py
!실행진입.py
!나라장터수집기.spec
!빌드.bat
!배포/
!배포/실행.bat

# ------------------------------------------------------------
#  일부러 뺀 것 (참고)
#
#  config.yaml            인증키 + 실제 수신자 주소
#  수집결과/ 공고목록/      실행하면 생기는 산출물
#  로그/                  실행 기록
#  백업/                  편집기가 저장 전에 떠두는 원본
#  공고문pdf/             실제 공고문
#  검증용_공고목록.md       사내 검증 자료
#  요구사항/ 보관/         사내 문서 (기관_입찰공고_페이지.md 만 예외)
#  진단.py 실측.py         개발용 스크립트
#  업계참여추적.py
#  조달청_OpenAPI*.docx    조달청 배포 자료
#  README.pdf             README.md 를 렌더링한 것
#  __pycache__/ .claude/
# ------------------------------------------------------------
